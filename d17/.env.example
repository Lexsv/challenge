SERVER_HOST=127.0.0.1
SERVER_PORT=3000
DATABASE_PATH=./data/tasks.sqlite
POLL_INTERVAL_MS=1000
SESSION_IDLE_MS=900000
DEFAULT_TIMEZONE=UTC
LOG_LEVEL=info
# Supply a private, randomly generated token before starting the server.
MCP_AUTH_TOKEN=
# LAN also requires the following TLS paths and exact HTTPS origin list.
# ALLOWED_ORIGINS=https://client.example
# TLS_CERT_PATH=
# TLS_KEY_PATH=

# Per output stream; MB uses decimal bytes. Archives are gzip-compressed.
LOG_DIR=./data/logs
LOG_MAX_SIZE_MB=10
LOG_MAX_ARCHIVES=5
