MCP_HOST=127.0.0.1
MCP_PORT=3018
# Leave unset for local runs. Docker can listen on its bridge with 0.0.0.0.
# MCP_BIND_HOST=
# Set a random bearer secret outside Git.
MCP_AUTH_TOKEN=
# Set absolute paths for your deployment.
TLS_CERT_PATH=
TLS_KEY_PATH=
DATABASE_PATH=
MCP_ALLOWED_ORIGINS=
PROVIDER_TIMEOUT_MS=8000
# macOS log capture only. LOG_DIRECTORY defaults to the database parent.
# LOG_DIRECTORY=
LOG_MAX_BYTES=10000000
